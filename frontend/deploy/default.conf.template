# Serves the built dashboard and forwards /api to FastAPI. ${API_UPSTREAM} and
# ${NGINX_RESOLVER} are filled in from the environment when the container starts
# (defaults: api:8000, the Compose service, and Docker's embedded DNS).

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Look the API up again every 10 s, so a recreated API container (new IP) is found
    # without restarting nginx. That needs the upstream in a variable.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # /api/test-runs?x=1 -> http://api:8000/test-runs?x=1, forwarding the original
    # (still URL-encoded) path and query rather than nginx's decoded copy.
    location /api/ {
        if ($request_uri ~ "^/api(?<api_uri>/.*)$") {}
        proxy_pass http://$api_upstream$api_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        # Approval decisions resume the agent, which can take a while.
        proxy_read_timeout 120s;
        client_max_body_size 1m;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Liveness of nginx itself; the container health check goes through /api instead.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Fingerprinted build output never changes, so it can be cached for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Single-page app: unknown paths (e.g. /traces/<id> on refresh) get index.html.
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri $uri/ /index.html;
    }
}
