# Copy to backend/.env and set a real password. Never commit backend/.env.
ENVIRONMENT=development

# Used by the local Postgres container (docker-compose.yml)
POSTGRES_USER=arl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_reliability_lab

# Used by the backend; must match the values above
DATABASE_URL=postgresql+psycopg://arl:change-me@localhost:5433/agent_reliability_lab
