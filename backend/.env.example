# Copy to backend/.env and set a real password. Never commit backend/.env.
# Docker Compose and the backend (on the host or in containers) both read this file.

# ---- Required ---------------------------------------------------------------------
# Postgres credentials. The db container creates the database with these on first start.
POSTGRES_USER=arl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_reliability_lab

# How host-side tools (pytest, alembic, uvicorn --reload) reach that Postgres; must use
# the same user, password and database. The containers ignore it and use db:5432.
DATABASE_URL=postgresql+psycopg://arl:change-me@localhost:5433/agent_reliability_lab

# ---- Safe defaults ----------------------------------------------------------------
# development | test | production (the containers always run as production)
ENVIRONMENT=development
# Logging: text (readable locally) or json (CloudWatch / CI)
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---- Optional integrations --------------------------------------------------------
# Claude. Without a key the stack still starts and the dashboard works; endpoints that
# need Claude (live chat, starting test runs, approval decisions) answer 503.
# ANTHROPIC_API_KEY=

# LangSmith tracing (https://smith.langchain.com). Off by default; nothing is sent
# while it's off. LANGSMITH_HIDE_CONTENT=true sends structure and timing only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-reliability-lab
LANGSMITH_HIDE_CONTENT=true

# ---- Compose ports (read from your shell, not from this file) ----------------------
# POSTGRES_HOST_PORT=5433   loopback port for Postgres
# DASHBOARD_PORT=8080       loopback port for the dashboard
