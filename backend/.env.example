# Copy to backend/.env and set a real password. Never commit backend/.env.
ENVIRONMENT=development

# Used by the local Postgres container (docker-compose.yml)
POSTGRES_USER=arl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_reliability_lab

# Used by the backend; must match the values above
DATABASE_URL=postgresql+psycopg://arl:change-me@localhost:5433/agent_reliability_lab

# Logging: text (readable locally) or json (CloudWatch / CI)
LOG_LEVEL=INFO
LOG_FORMAT=text

# Optional LangSmith tracing (https://smith.langchain.com). Leave LANGSMITH_TRACING=false
# unless you have a key; nothing is sent to LangSmith while it's off.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-reliability-lab
